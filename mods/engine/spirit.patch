diff --git a/src/spirit/spirit.go b/src/spirit/spirit.go
new file mode 100644
index 0000000..fcb4a80
--- /dev/null
+++ b/src/spirit/spirit.go
@@ -0,0 +1,83 @@
+// Package spirit implements the "Spirit" class variant (dystopiannox mod).
+//
+// Nox hardcodes exactly three player classes (Warrior=0, Wizard=1, Conjurer=2) in the
+// network protocol, save files, gamedata.bin stat tables, spell tables and GUI art.
+// Instead of adding a 4th enum value (which would break saves, multiplayer and every
+// class-indexed table), the Spirit mod re-skins one caster class slot as a new class
+// (default: Conjurer -> "Mystic") whose mana pool becomes "Spirit":
+//
+//   - the HUD tube, the small bar next to the player and the bubbles are drawn cyan;
+//   - all "Mana" texts read "Spirit" and the class name reads "Mystic";
+//   - Spirit regenerates 3x slower than mana over time;
+//   - mana obelisks / crystals do not refill Spirit;
+//   - Spirit is gained by landing physical hits (melee weapons, arrows, fists):
+//     HitPercent% of the damage dealt.
+//
+// The package is a leaf so that both the legacy (cgo) and the main package can use it.
+package spirit
+
+import (
+	"strings"
+)
+
+const (
+	// PassiveSlowdown divides the passive (over time) regeneration rate.
+	PassiveSlowdown = 3
+	// HitPercent is the share of physical damage dealt that is converted to Spirit.
+	HitPercent = 50
+)
+
+var (
+	enabled   bool
+	class     = 2 // player.Conjurer
+	className = "Mystic"
+	baseName  = "Conjurer"
+)
+
+// Enable turns the Spirit variant on for a given base class ("conjurer" or "wizard").
+// An empty or "off" value disables it. It returns false if the value is invalid.
+func Enable(base string, name string) bool {
+	switch strings.ToLower(strings.TrimSpace(base)) {
+	case "", "off", "no", "false", "0":
+		enabled = false
+		return true
+	case "conjurer", "con", "2", "on", "yes", "true", "1":
+		class, baseName = 2, "Conjurer"
+	case "wizard", "wiz":
+		class, baseName = 1, "Wizard"
+	default:
+		return false
+	}
+	enabled = true
+	if name = strings.TrimSpace(name); name != "" {
+		className = name
+	}
+	return true
+}
+
+// Enabled reports if the Spirit variant is active in this process.
+func Enabled() bool { return enabled }
+
+// Class returns the player class index that is replaced by the Spirit class.
+func Class() int { return class }
+
+// BaseName returns the original name of the replaced class ("Conjurer").
+func BaseName() string { return baseName }
+
+// Name returns the display name of the Spirit class ("Mystic").
+func Name() string { return className }
+
+// IsClass reports if a given player class uses Spirit instead of mana.
+func IsClass(c int) bool { return enabled && c == class }
+
+// HitGain returns how much Spirit is gained for dealing dmg physical damage.
+func HitGain(dmg int) int {
+	if dmg <= 0 {
+		return 0
+	}
+	v := dmg * HitPercent / 100
+	if v < 1 {
+		v = 1
+	}
+	return v
+}
diff --git a/src/spirit_strings.go b/src/spirit_strings.go
new file mode 100644
index 0000000..07716a2
--- /dev/null
+++ b/src/spirit_strings.go
@@ -0,0 +1,153 @@
+package opennox
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/noxworld-dev/opennox-lib/log"
+	"github.com/noxworld-dev/opennox-lib/strman"
+
+	"github.com/noxworld-dev/opennox/v1/spirit"
+)
+
+// spiritFlagDefault returns the default value of the -spirit flag: builds named
+// "*spirit*" (e.g. opennox-spirit-hd.exe) enable the Spirit class by default.
+func spiritFlagDefault(exe string) string {
+	if strings.Contains(strings.ToLower(filepath.Base(exe)), "spirit") {
+		return "conjurer"
+	}
+	return ""
+}
+
+// spiritClassFiles lists string tables where the class name is replaced.
+var spiritClassFiles = []string{"selchar.c:", "selclass.c:", "client.c:", "guisave.c:", "nox.str:", "experience:", "access.c:"}
+
+// spiritClassText returns the patched text of a class-name string (lid is the lower-case string ID).
+func spiritClassText(lid, s string) string {
+	base, name := spirit.BaseName(), spirit.Name()
+	lbase := strings.ToLower(base)
+	switch lid {
+	case "guirank.c:" + lbase: // scoreboard abbreviation: "CON"
+		return strings.ToUpper(name[:min(3, len(name))])
+	case "spelllst.c:spell" + lbase: // spell list abbreviation: "Conj"
+		return name[:min(4, len(name))]
+	case "selclass.c:" + lbase: // class description on the new character screen
+		s = strings.ReplaceAll(s, base, name)
+		s = strings.Replace(s, "Magic:", "Spirit:", 1)
+		return s + " Their spells are fuelled by Spirit, not mana: it returns slowly, is won back by striking foes, and crystals cannot restore it."
+	}
+	s = strings.ReplaceAll(s, base, name)
+	return strings.ReplaceAll(s, strings.ToUpper(base), strings.ToUpper(name))
+}
+
+// spiritManaIDs lists string IDs (lower case) or ID prefixes (ending with '*') where "mana" becomes "spirit".
+var spiritManaIDs = []string{
+	"guimeter.c:tooltipmana",
+	"guiinv.c:statsmana",
+	"guibook.c:manacost*",
+	"plyrspel.c:notenoughmana*",
+	"spell.c:notenoughmana*",
+	"glyph.c:notenoughmana*",
+	"thing.db:bluepotion*",
+	"generalprint:bluepotion",
+}
+
+func spiritIsManaID(id string) bool {
+	id = strings.ToLower(id)
+	for _, p := range spiritManaIDs {
+		if strings.HasSuffix(p, "*") {
+			if strings.HasPrefix(id, p[:len(p)-1]) {
+				return true
+			}
+		} else if id == p {
+			return true
+		}
+	}
+	return false
+}
+
+func spiritReplaceMana(s string) string {
+	r := strings.NewReplacer("magic source (mana)", "Spirit", "Mana", "Spirit", "mana", "spirit", "MANA", "SPIRIT")
+	return r.Replace(s)
+}
+
+// spiritPatchStrings rewrites the loaded string table: class name -> Spirit class name, Mana -> Spirit.
+// strman has no API to edit entries, so the table is round-tripped through a temporary JSON file.
+func spiritPatchStrings(sm *strman.StringManager) error {
+	if !spirit.Enabled() {
+		return nil
+	}
+	dir, err := os.MkdirTemp("", "opennox-spirit-")
+	if err != nil {
+		return err
+	}
+	defer os.RemoveAll(dir)
+	path := filepath.Join(dir, "strings.csf.json")
+	if err := sm.WriteJSON(path, false); err != nil {
+		return err
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return err
+	}
+	var file struct {
+		Lang    int            `json:"lang,omitempty"`
+		Entries []strman.Entry `json:"entries"`
+	}
+	if err := json.Unmarshal(data, &file); err != nil {
+		return err
+	}
+	base, name := spirit.BaseName(), spirit.Name()
+	nClass, nMana := 0, 0
+	for i := range file.Entries {
+		e := &file.Entries[i]
+		lid := strings.ToLower(string(e.ID))
+		isClass := lid == "guirank.c:"+strings.ToLower(base) || lid == "spelllst.c:spell"+strings.ToLower(base)
+		for _, f := range spiritClassFiles {
+			if strings.HasPrefix(lid, f) && strings.Contains(lid, strings.ToLower(base)) {
+				isClass = true
+				break
+			}
+		}
+		isMana := spiritIsManaID(lid)
+		if !isClass && !isMana {
+			continue
+		}
+		for j := range e.Vals {
+			v := &e.Vals[j]
+			if isClass {
+				v.Str = spiritClassText(lid, v.Str)
+				if v.Str2 != "" {
+					v.Str2 = strings.ReplaceAll(v.Str2, base, name)
+				}
+			}
+			if isMana {
+				v.Str = spiritReplaceMana(v.Str)
+				v.Str2 = spiritReplaceMana(v.Str2)
+			}
+		}
+		if isClass {
+			nClass++
+		}
+		if isMana {
+			nMana++
+		}
+	}
+	data, err = json.Marshal(file)
+	if err != nil {
+		return err
+	}
+	if err := os.WriteFile(path, data, 0644); err != nil {
+		return err
+	}
+	if err := sm.ReadJSON(path); err != nil {
+		return err
+	}
+	log.Printf("spirit: %s is now %s (Spirit instead of mana); patched %d class and %d mana strings", base, name, nClass, nMana)
+	for _, id := range []strman.ID{"SelChar.c:" + strman.ID(base), "experience:" + strman.ID(base) + "9", "guirank.c:" + strman.ID(base), "guimeter.c:ToolTipMana", "GuiInv.c:StatsMana", "guibook.c:ManaCostHigh", "thing.db:BluePotionDescription"} {
+		log.Printf("spirit: string %s = %q", id, sm.GetString(id))
+	}
+	return nil
+}
