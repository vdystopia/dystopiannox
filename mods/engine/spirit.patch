+++ b/src/legacy/spirit.go
@@ -0,0 +1,71 @@
+package legacy
+
+/*
+#include "defs.h"
+#include "GAME3_3.h"
+*/
+import "C"
+
+import (
+	"github.com/noxworld-dev/opennox-lib/object"
+
+	"github.com/noxworld-dev/opennox/v1/spirit"
+)
+
+// nox_spirit_isClass reports if a player class index uses Spirit instead of mana (used by the HUD).
+//
+//export nox_spirit_isClass
+func nox_spirit_isClass(cl C.int) C.int {
+	if spirit.IsClass(int(cl)) {
+		return 1
+	}
+	return 0
+}
+
+// nox_spirit_unitIsSpirit reports if a unit is a player of the Spirit class.
+//
+//export nox_spirit_unitIsSpirit
+func nox_spirit_unitIsSpirit(cobj *nox_object_t) C.int {
+	if !spirit.Enabled() || cobj == nil {
+		return 0
+	}
+	u := asObjectS(cobj)
+	if !u.Class().Has(object.ClassPlayer) {
+		return 0
+	}
+	ud := u.UpdateDataPlayer()
+	if ud == nil || ud.Player == nil {
+		return 0
+	}
+	if spirit.IsClass(int(ud.Player.PlayerClass())) {
+		return 1
+	}
+	return 0
+}
+
+// nox_spirit_onPhysicalHit is called by the default damage handler after the final damage is known.
+// A Spirit class player regains Spirit by landing physical hits (melee, arrows, fists) on creatures.
+//
+//export nox_spirit_onPhysicalHit
+func nox_spirit_onPhysicalHit(attacker, victim, weapon *nox_object_t, dmg C.int, typ C.int) {
+	if nox_spirit_unitIsSpirit(attacker) == 0 || victim == nil || attacker == victim {
+		return
+	}
+	switch object.DamageType(typ) {
+	case object.DamageBlade, object.DamageCrush, object.DamageImpale, object.DamageClaw:
+	default:
+		return
+	}
+	if weapon != nil && weapon != attacker {
+		w := asObjectS(weapon)
+		if w.Class().Has(object.ClassWand) {
+			return
+		}
+	}
+	if v := asObjectS(victim); !v.Class().HasAny(object.ClassMonster | object.ClassPlayer) {
+		return
+	}
+	if gain := spirit.HitGain(int(dmg)); gain > 0 {
+		C.nox_xxx_playerManaAdd_4EEB80(attacker, C.short(gain))
+	}
+}
